-- Out-of-bounds array access returns nil (1-based indexing)
lokal arr = [1, 2, 3]

lokal val = arr[100]
assert(val == nil, "Out of bounds array access should return nil")

lokal val2 = arr[-1]
assert(val2 == nil, "Negative index array access should return nil")

-- Valid access still works
assert(arr[1] == 1, "arr[1] should be 1")
assert(arr[3] == 3, "arr[3] should be 3")
